# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard access
ADMIN_SECRET=your-secret-admin-key

# Project availability toggle
# Set to "false" to switch site to waitlist-only mode (hides booking, shows waitlist CTA)
# Set to "true" (or omit) to accept new projects (shows booking CTA)
NEXT_PUBLIC_ACCEPTING_PROJECTS=true

# Email notifications (owner email for receiving notifications)
OWNER_EMAIL=you@yourdomain.com

# Site URL (used in email links)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Email sending (optional - uses Resend.com)
# Sign up at https://resend.com for free tier
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=noreply@yourdomain.com
